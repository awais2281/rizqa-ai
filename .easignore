# EAS Build ignore file - excludes files from upload to reduce size

# Node modules (already excluded by default, but explicit)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Expo
.expo/
.expo-shared/
dist/
web-build/

# Build artifacts
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# macOS
.DS_Store

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Git
.git/
.gitignore

# Documentation (not needed for build)
*.md
!README.md

# Test files
**/__tests__/
**/*.test.*
**/*.spec.*

# Duplicate model files - only include assets/models/ in the build
# Exclude the models/ folder since we're using assets/models/ for bundling
models/
!assets/models/

# Temporary files
*.tmp
*.temp
*.log

# OS files
Thumbs.db
desktop.ini

